{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.49.2.45890",
      "templateHash": "3439255836869119679"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "uksouth"
    },
    "cosmosAccountName": {
      "type": "string",
      "defaultValue": "cosmo-spotify"
    }
  },
  "resources": [
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2026-03-15",
      "name": "[parameters('cosmosAccountName')]",
      "location": "[parameters('location')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "enableFreeTier": true,
        "capacity": {
          "totalThroughputLimit": 1000
        },
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0,
            "isZoneRedundant": false
          }
        ],
        "enableMultipleWriteLocations": false,
        "enableAutomaticFailover": true,
        "minimalTlsVersion": "Tls12",
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "backupPolicy": {
          "type": "Periodic",
          "periodicModeProperties": {
            "backupIntervalInMinutes": 240,
            "backupRetentionIntervalInHours": 8,
            "backupStorageRedundancy": "Local"
          }
        }
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2026-03-15",
      "name": "[format('{0}/{1}', parameters('cosmosAccountName'), 'spotify')]",
      "properties": {
        "resource": {
          "id": "spotify"
        },
        "options": {
          "throughput": 1000
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', parameters('cosmosAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers",
      "apiVersion": "2026-03-15",
      "name": "[format('{0}/{1}/{2}', parameters('cosmosAccountName'), 'spotify', 'app')]",
      "properties": {
        "resource": {
          "id": "app",
          "partitionKey": {
            "paths": [
              "/spotifyUserId"
            ],
            "kind": "Hash"
          },
          "defaultTtl": -1
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', parameters('cosmosAccountName'), 'spotify')]"
      ]
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "id-spotify-api",
      "location": "[parameters('location')]"
    }
  ],
  "outputs": {
    "apiIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'id-spotify-api'), '2024-11-30').clientId]"
    },
    "apiIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'id-spotify-api')]"
    }
  }
}