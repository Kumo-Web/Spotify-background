<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>cadd8b65-3e61-4c14-9b99-dc0b33aa3d89</UserSecretsId>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!--
      OpenTelemetry.* removed: it was registered with AddConsoleExporter() only, so every trace
      printed to stdout and vanished. Sentry.AspNetCore instruments requests, HttpClient and
      DiagnosticSource natively, which covers Spotify and Cosmos calls without a second layer
      or the duplicate-span problem the bridge introduces.
    -->
    <PackageReference Include="Sentry.AspNetCore" />
  </ItemGroup>

  <ItemGroup Label="DataProtection">
    <!-- Key ring must outlive the container: replicas are ephemeral on Container Apps. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
