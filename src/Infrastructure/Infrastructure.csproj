<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Label="Spotify">
    <PackageReference Include="SpotifyAPI.Web" />
    <PackageReference Include="SpotifyAPI.Web.Auth" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- Cosmos SDK direct. EF Core removed: the data model is 8 document types of point reads. -->
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <!-- IDataProtector, for encrypting Spotify refresh tokens at rest. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Sentry (not Sentry.AspNetCore) so Infrastructure can emit gen_ai.* spans and check-ins. -->
    <PackageReference Include="Sentry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Lets the unit tests reach internal types (Pkce, the Cosmos store, the repositories) without
      widening the production surface. These are implementation details that consumers should
      only ever see through their interfaces.
    -->
    <InternalsVisibleTo Include="InfrastructureTests" />
  </ItemGroup>

</Project>
